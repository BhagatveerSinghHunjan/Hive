{
  "name": "hive-desktop",
  "productName": "HIVE",
  "private": true,
  "version": "0.1.0",
  "description": "HIVE Desktop — Electron demo shell for the HIVE agent runtime",
  "author": "HIVE",
  "main": "electron/main.cjs",
  "scripts": {
    "brand": "node scripts/brand-electron.cjs",
    "predev": "node scripts/brand-electron.cjs",
    "dev": "concurrently -k -n VITE,HIVE \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:debug": "concurrently -k -n VITE,HIVE \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron . --remote-debugging-port=9333\"",
    "prebuild": "node scripts/brand-electron.cjs",
    "build": "tsc --noEmit && vite build",
    "prestart": "node scripts/brand-electron.cjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder --mac zip --arm64",
    "dist:win": "npm run build && electron-builder --win zip --x64",
    "dist:all": "npm run build && electron-builder --mac zip --arm64 && electron-builder --win zip --x64",
    "dist:dir": "npm run build && electron-builder --mac dir",
    "publish-landing": "node scripts/publish-download.js"
  },
  "build": {
    "appId": "com.hive.desktop",
    "productName": "HIVE",
    "copyright": "Copyright © HIVE",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../hive",
        "to": "hive-runtime/hive",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../requirements.txt",
        "to": "hive-runtime/requirements.txt"
      },
      {
        "from": "../.env.example",
        "to": "hive-runtime/.env.example"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "HIVE-mac-${arch}.${ext}",
      "identity": null
    },
    "win": {
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "HIVE-windows-${arch}.${ext}"
    },
    "asar": true
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}
